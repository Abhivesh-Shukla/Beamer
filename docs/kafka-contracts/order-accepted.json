{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderAcceptedEvent",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event"
    },
    "eventType": {
      "type": "string",
      "enum": ["order-accepted"],
      "description": "Event type identifier"
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the accepted order"
    },
    "restaurantId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the accepting restaurant"
    },
    "prepTimeMinutes": {
      "type": "integer",
      "minimum": 1,
      "description": "Estimated food preparation time in minutes"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when order was accepted"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "orderId",
    "restaurantId",
    "prepTimeMinutes",
    "timestamp"
  ],
  "additionalProperties": false
}
